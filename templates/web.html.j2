<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Auction Watch</title>
<style>
*,*::before,*::after{box-sizing:border-box}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;background:#f4f4f2;color:#1a1a1a}
header{background:#fff;border-bottom:1px solid #eaeaea;padding:20px 24px}
h1{margin:0;font-size:20px;font-weight:600;letter-spacing:-0.01em}
.meta{font-size:13px;color:#777;margin:4px 0 0}
#bar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding:12px 24px;background:#fafafa;border-bottom:1px solid #eaeaea}
.chip{padding:4px 12px;border-radius:100px;border:1px solid #d0d0d0;background:#fff;font-size:12px;cursor:pointer;white-space:nowrap;color:#1a1a1a;transition:background .12s,color .12s,border-color .12s}
.chip:hover{background:#f0f0f0}
.chip.active{background:#1a1a1a;color:#fff;border-color:#1a1a1a}
#sort-btn{margin-left:auto;padding:4px 12px;border-radius:100px;border:1px solid #d0d0d0;background:#fff;font-size:12px;cursor:pointer;color:#555;white-space:nowrap}
#sort-btn:hover{background:#f0f0f0}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;padding:20px 24px;max-width:1440px;margin:0 auto}
.card{background:#fff;border-radius:8px;border:1px solid #eaeaea;overflow:hidden;display:flex;flex-direction:column}
.card[hidden]{display:none!important}
.card-img{width:100%;aspect-ratio:4/3;object-fit:cover;background:#f0f0f0;display:block}
.card-img-ph{width:100%;aspect-ratio:4/3;background:#f0f0f0}
.card-body{padding:12px 14px 14px;flex:1;display:flex;flex-direction:column;gap:3px}
.card-artist{font-size:11px;color:#888;text-transform:uppercase;letter-spacing:.06em}
.card-artist a{color:#888;text-decoration:none}
.card-artist a:hover{color:#1a1a1a}
.card-title{font-size:14px;font-weight:500;line-height:1.3;margin:2px 0 4px}
.card-title a{color:#1a1a1a;text-decoration:none}
.card-title a:hover{text-decoration:underline}
.card-house{font-size:12px;color:#555}
.card-estimate{font-size:12px;color:#555}
.card-date{font-size:12px;color:#d4541a;margin-top:4px}
#empty{display:none;text-align:center;padding:80px 24px;color:#777;font-size:15px}
@media(max-width:600px){
  #bar{padding:10px 14px}
  #grid{padding:14px;gap:10px}
}
</style>
</head>
<body>

<header>
  <h1>Auction Watch</h1>
  <p class="meta">
    {{- generated_at.strftime('%A, %B %-d, %Y') -}}
    {%- if lots -%}
      {%- set auction_lots = lots | selectattr('close_date') | list -%}
      {%- set dealer_lots = lots | rejectattr('close_date') | list -%}
      &nbsp;&middot;
      {%- if auction_lots %} {{ auction_lots|length }} at auction{%- endif -%}
      {%- if auction_lots and dealer_lots %},{%- endif -%}
      {%- if dealer_lots %} {{ dealer_lots|length }} dealer listing{{ '' if dealer_lots|length == 1 else 's' }}{%- endif -%}
    {%- endif -%}
  </p>
</header>

<div id="bar">
  <button class="chip active" data-artist="">All artists</button>
  {% for artist in artists -%}
  <button class="chip" data-artist="{{ artist }}">{{ artist }}</button>
  {% endfor %}
  <button id="sort-btn">Sorted by date</button>
</div>

<main id="grid">
  {% for lot in lots %}
  <article class="card"
    data-artist="{{ lot.artist }}"
    data-date="{{ lot.close_date.isoformat() if lot.close_date else '' }}"
    data-house="{{ lot.house }}">
    {% if lot.image_url -%}
    <img class="card-img" src="{{ lot.image_url }}" alt="" loading="lazy">
    {%- else -%}
    <div class="card-img-ph"></div>
    {%- endif %}
    <div class="card-body">
      <div class="card-artist">
        {%- set slug = artist_slugs.get(lot.artist) -%}
        {%- if slug -%}<a href="https://www.artsy.net/artist/{{ slug }}" target="_blank" rel="noopener">{{ lot.artist }}</a>{%- else -%}{{ lot.artist }}{%- endif -%}
      </div>
      <div class="card-title"><a href="{{ lot.url }}" target="_blank" rel="noopener">{{ lot.title }}</a></div>
      <div class="card-house">{{ lot.house }}</div>
      <div class="card-estimate">{{ lot | estimate }}</div>
      <div class="card-date">
        {%- if lot.close_date -%}Closes {{ lot.close_date.strftime('%a %b %-d, %H:%M UTC') }}{%- else -%}Available now{%- endif -%}
      </div>
    </div>
  </article>
  {% endfor %}
</main>
<p id="empty">No lots match the selected artist.</p>

<footer style="text-align:center;padding:24px;font-size:11px;color:#aaa;">
  Generated by auction-watch &middot; Updated daily
</footer>

<script>
(function () {
  var grid = document.getElementById('grid');
  var empty = document.getElementById('empty');
  var sortBtn = document.getElementById('sort-btn');
  var cards = Array.from(grid.querySelectorAll('.card'));
  var activeArtist = '';
  var sortMode = 'date';

  function applyFilter() {
    var visible = 0;
    cards.forEach(function (c) {
      var show = !activeArtist || c.dataset.artist === activeArtist;
      c.hidden = !show;
      if (show) visible++;
    });
    empty.style.display = visible ? 'none' : 'block';
  }

  function applySort() {
    var sorted = cards.slice().sort(function (a, b) {
      if (sortMode === 'house') {
        return (a.dataset.house || '').localeCompare(b.dataset.house || '');
      }
      var da = a.dataset.date, db = b.dataset.date;
      if (da && db) return da < db ? -1 : da > db ? 1 : 0;
      if (da) return -1;
      if (db) return 1;
      return (a.dataset.artist || '').localeCompare(b.dataset.artist || '');
    });
    sorted.forEach(function (c) { grid.appendChild(c); });
  }

  document.getElementById('bar').addEventListener('click', function (e) {
    var chip = e.target.closest('.chip');
    if (!chip) return;
    document.querySelectorAll('.chip').forEach(function (c) { c.classList.remove('active'); });
    chip.classList.add('active');
    activeArtist = chip.dataset.artist;
    applyFilter();
  });

  sortBtn.addEventListener('click', function () {
    sortMode = sortMode === 'date' ? 'house' : 'date';
    sortBtn.textContent = sortMode === 'date' ? 'Sorted by date' : 'Sorted by house';
    applySort();
  });
}());
</script>
</body>
</html>
